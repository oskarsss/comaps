<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/riga_journey_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical">
  <com.google.android.material.appbar.MaterialToolbar android:id="@+id/riga_journey_toolbar"
      android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" />
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
      android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="@string/riga_journey_intro" />
      <Button android:id="@+id/riga_from" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="@string/riga_choose_from" />
      <Button android:id="@+id/riga_to" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="@string/riga_choose_to" />
      <Button android:id="@+id/riga_when" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="@string/riga_leave_now" />
      <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/riga_estimates"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="@string/riga_use_estimates" />
      <Button android:id="@+id/riga_plan" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="@string/riga_plan" />
      <TextView android:id="@+id/riga_journey_status" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:minHeight="72dp" android:paddingVertical="12dp"
          android:accessibilityLiveRegion="polite" />
      <LinearLayout android:id="@+id/riga_legs" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:orientation="vertical" />
      <Button android:id="@+id/riga_journey_map" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="@string/riga_journey_map" android:visibility="gone" />
      <Button android:id="@+id/riga_clear_journey" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="@string/riga_clear_journey" />
    </LinearLayout>
  </ScrollView>
</LinearLayout>
