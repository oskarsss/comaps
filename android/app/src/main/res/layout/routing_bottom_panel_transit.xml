<?xml version="1.0" encoding="utf-8"?>
<app.organicmaps.routing.TransitPanelLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/transit_panel"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:paddingStart="@dimen/margin_base"
  android:paddingEnd="@dimen/margin_base"
  android:paddingBottom="@dimen/margin_half">
  <!-- The sheet's grip: drag up or tap to open every step of the journey in this panel, drag down to close. -->
  <FrameLayout
    android:id="@+id/transit_handle"
    android:layout_width="0dp"
    android:layout_height="24dp"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true"
    android:visibility="gone"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    tools:visibility="visible">
    <View
      android:layout_width="32dp"
      android:layout_height="4dp"
      android:layout_gravity="center"
      android:importantForAccessibility="no"
      android:background="@drawable/bottom_sheet_handle"
      android:backgroundTint="?attr/colorOutline"/>
  </FrameLayout>
  <!-- Leads the panel when the journey sets off long after the chosen time, e.g. at night. -->
  <com.google.android.material.card.MaterialCardView
    android:id="@+id/transit_wait"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:visibility="gone"
    android:accessibilityLiveRegion="polite"
    app:cardBackgroundColor="?attr/colorTertiaryContainer"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toBottomOf="@id/transit_handle"
    android:layout_marginTop="@dimen/margin_half_plus"
    tools:visibility="visible">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:paddingStart="12dp"
      android:paddingTop="10dp"
      android:paddingEnd="12dp"
      android:paddingBottom="10dp">
      <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_clock"
        app:tint="?attr/colorOnTertiaryContainer"/>
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
          android:id="@+id/transit_wait_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFeatureSettings="tnum"
          android:textAppearance="?attr/textAppearanceTitleSmall"
          android:textStyle="bold"
          android:textColor="?attr/colorOnTertiaryContainer"
          tools:text="First departure 04:46, in 4 h 33 min"/>
      </LinearLayout>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <!-- Manage Route: change, add or reorder the route's points. A quiet icon at the end of the header row;
       the Start / End trip action floats over the sheet's top edge (transit_start_fab in activity_map). -->
  <com.google.android.material.button.MaterialButton
    android:id="@+id/transit_manage"
    style="@style/Widget.Material3.Button.IconButton"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:layout_marginEnd="-8dp"
    android:contentDescription="@string/planning_route_manage_route"
    android:tooltipText="@string/planning_route_manage_route"
    app:icon="@drawable/ic_edit"
    app:iconSize="22dp"
    app:iconTint="?android:textColorSecondary"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toBottomOf="@id/transit_wait"/>
  <!-- When to travel, beside Manage Route: what is chosen ("Now", "Arrive 18:45") opens the choice. -->
  <com.google.android.material.button.MaterialButton
    android:id="@+id/transit_header_time"
    style="@style/Widget.Material3.Button.TonalButton"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="0dp"
    android:minHeight="40dp"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:fontFeatureSettings="tnum"
    android:maxLines="1"
    android:visibility="gone"
    app:icon="@drawable/ic_clock"
    app:iconSize="16dp"
    app:iconPadding="4dp"
    app:layout_constraintEnd_toStartOf="@id/transit_manage"
    app:layout_constraintTop_toTopOf="@id/transit_manage"
    app:layout_constraintBottom_toBottomOf="@id/transit_manage"
    tools:text="Now"
    tools:visibility="visible"/>
  <!-- Leaving now: plan again from where the rider is, at the current time. -->
  <com.google.android.material.button.MaterialButton
    android:id="@+id/transit_header_refresh"
    style="@style/Widget.Material3.Button.IconButton"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:visibility="gone"
    android:contentDescription="@string/riga_time_refresh"
    android:tooltipText="@string/riga_time_refresh"
    app:icon="@drawable/ic_refresh"
    app:iconSize="22dp"
    app:iconTint="?android:textColorSecondary"
    app:layout_constraintEnd_toStartOf="@id/transit_header_time"
    app:layout_constraintTop_toTopOf="@id/transit_manage"
    app:layout_constraintBottom_toBottomOf="@id/transit_manage"
    tools:visibility="visible"/>
  <!-- Share: a short "from → to, 19:57–20:14" and a link that opens the same plan. -->
  <com.google.android.material.button.MaterialButton
    android:id="@+id/transit_share"
    style="@style/Widget.Material3.Button.IconButton"
    android:layout_width="44dp"
    android:layout_height="48dp"
    android:visibility="gone"
    android:contentDescription="@string/share"
    android:tooltipText="@string/share"
    app:icon="@drawable/ic_share"
    app:iconSize="20dp"
    app:iconTint="?android:textColorSecondary"
    app:layout_constraintEnd_toStartOf="@id/transit_header_refresh"
    app:layout_constraintTop_toTopOf="@id/transit_manage"
    app:layout_constraintBottom_toBottomOf="@id/transit_manage"
    tools:visibility="visible"/>
  <com.google.android.material.textview.MaterialTextView
    android:id="@+id/total_time"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFeatureSettings="tnum"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="@id/transit_manage"
    app:layout_constraintBottom_toBottomOf="@id/transit_manage"
    style="@style/MwmWidget.TextView.PlanDetail.Number.Time"
    tools:text="40 min"/>
  <com.google.android.material.textview.MaterialTextView
    android:id="@+id/dot"
    style="@style/MwmWidget.TextView.PlanDetail.Number.Secondary"
    android:layout_marginStart="@dimen/margin_quarter_plus"
    android:layout_marginEnd="@dimen/margin_quarter_plus"
    android:text="•"
    android:importantForAccessibility="no"
    app:layout_constraintStart_toEndOf="@id/total_time"
    app:layout_constraintBaseline_toBaselineOf="@id/total_time"
    tools:ignore="HardcodedText"/>
  <com.google.android.material.imageview.ShapeableImageView
    android:id="@+id/pedestrian_icon"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margin_quarter_plus"
    app:srcCompat="@drawable/ic_20px_route_planning_walk"
    app:layout_constraintBottom_toBottomOf="@id/total_time"
    app:layout_constraintStart_toEndOf="@id/dot"
    android:tint="?iconTint"/>
  <com.google.android.material.textview.MaterialTextView
    android:id="@+id/total_distance"
    style="@style/MwmWidget.TextView.PlanDetail.Number.Secondary"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFeatureSettings="tnum"
    android:maxLines="1"
    android:ellipsize="end"
    app:layout_constrainedWidth="true"
    app:layout_constraintHorizontal_bias="0"
    app:layout_constraintEnd_toStartOf="@id/transit_share"
    app:layout_goneMarginStart="@dimen/margin_quarter_plus"
    app:layout_constraintStart_toEndOf="@id/pedestrian_icon"
    app:layout_constraintBaseline_toBaselineOf="@id/total_time"
    tools:text="1 km"/>
  <ScrollView
    android:id="@+id/transit_chips_scroll"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    app:layout_constraintHeight_max="240dp"
    android:layout_marginTop="@dimen/margin_quarter"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toStartOf="@id/transit_chips_more"
    app:layout_constraintTop_toBottomOf="@id/transit_manage"
    android:scrollbarAlwaysDrawVerticalTrack="true">

    <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/transit_recycler_view"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
  </ScrollView>
  <!-- A long route's chips show two rows; this shows the rest (and folds them again). -->
  <ImageButton
    android:id="@+id/transit_chips_more"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:src="@drawable/ic_expand_more"
    app:tint="?android:attr/textColorSecondary"
    android:contentDescription="@string/riga_chips_more"
    android:visibility="gone"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintBottom_toBottomOf="@id/transit_chips_scroll"/>
  <LinearLayout
    android:id="@+id/transit_details"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toBottomOf="@id/transit_chips_scroll"
    app:layout_constraintStart_toStartOf="parent">
    <!-- The collapsed sheet: the trip's current and next step, or the plan's choices and summary. -->
    <LinearLayout android:id="@+id/transit_summary" android:orientation="vertical"
      android:layout_width="match_parent" android:layout_height="wrap_content">
      <!-- When to travel: one button that says what is chosen ("Leave now", "Arrive by 17:00") and opens the
           choice; beside a chosen time, a small cross goes back to leaving now. -->
      <LinearLayout android:id="@+id/transit_time" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:visibility="gone">
        <com.google.android.material.button.MaterialButton android:id="@+id/transit_time_choice"
          style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:fontFeatureSettings="tnum" android:maxLines="1"
          android:ellipsize="end" app:icon="@drawable/ic_clock" app:iconSize="18dp" tools:text="Leave now"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/transit_time_reset"
          style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp"
          android:layout_marginStart="2dp" android:visibility="gone"
          android:contentDescription="@string/riga_time_reset" android:tooltipText="@string/riga_time_reset"
          app:icon="@drawable/ic_close" app:iconSize="20dp" app:iconTint="?android:textColorSecondary"
          tools:visibility="visible"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/transit_time_refresh"
          style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp"
          android:layout_marginStart="2dp" android:visibility="gone"
          android:contentDescription="@string/riga_time_refresh" android:tooltipText="@string/riga_time_refresh"
          app:icon="@drawable/ic_refresh" app:iconSize="22dp" app:iconTint="?android:textColorSecondary"/>
        <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
        <!-- Manage Route while there is no header row yet (searching, or no route): beside the time. -->
        <com.google.android.material.button.MaterialButton android:id="@+id/transit_manage_inline"
          style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp"
          android:layout_marginEnd="-8dp" android:visibility="gone"
          android:contentDescription="@string/planning_route_manage_route"
          android:tooltipText="@string/planning_route_manage_route" app:icon="@drawable/ic_edit" app:iconSize="22dp"
          app:iconTint="?android:textColorSecondary"/>
      </LinearLayout>
      <!-- While following a journey: the step to do now, large, with a countdown; the step after it, quieter. -->
      <LinearLayout android:id="@+id/transit_trip" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="0dp"
        android:visibility="gone" tools:visibility="visible">
        <com.google.android.material.card.MaterialCardView android:id="@+id/transit_now"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:accessibilityLiveRegion="polite" app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
          app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="0dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="8dp"
            android:paddingEnd="12dp" android:paddingBottom="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
              android:orientation="horizontal" android:gravity="center_vertical">
              <TextView android:id="@+id/transit_now_badge" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minWidth="40dp" android:minHeight="32dp"
                android:gravity="center" android:fontFeatureSettings="tnum" android:textSize="16sp"
                android:textStyle="bold" android:importantForAccessibility="no" tools:text="49"/>
              <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:id="@+id/transit_now_title" android:layout_width="match_parent"
                  android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"
                  android:textAppearance="?attr/textAppearanceTitleMedium" android:textStyle="bold"
                  android:textColor="?android:textColorPrimary" tools:text="Walk to Dienvidu tilts"/>
                <TextView android:id="@+id/transit_now_detail" android:layout_width="match_parent"
                  android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="2"
                  android:ellipsize="end" android:fontFeatureSettings="tnum"
                  android:textAppearance="?attr/textAppearanceBodyMedium"
                  android:textColor="?android:textColorSecondary" tools:text="60 m · at the stop by 07:25"/>
              </LinearLayout>
              <LinearLayout android:id="@+id/transit_now_countdown" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="12dp" android:gravity="end"
                android:orientation="vertical">
                <TextView android:id="@+id/transit_now_label" android:layout_width="wrap_content"
                  android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceLabelMedium"
                  android:textColor="?android:textColorSecondary" tools:text="Departs in"/>
                <TextView android:id="@+id/transit_now_minutes" android:layout_width="wrap_content"
                  android:layout_height="wrap_content" android:fontFeatureSettings="tnum"
                  android:textAppearance="?attr/textAppearanceTitleLarge" android:textStyle="bold"
                  android:textColor="?android:textColorPrimary" tools:text="4 min"/>
              </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/transit_now_also" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:layout_marginStart="52dp" android:layout_marginTop="4dp"
              android:fontFeatureSettings="tnum" android:textAppearance="?attr/textAppearanceBodySmall"
              android:textColor="?android:textColorSecondary" android:visibility="gone"
              tools:text="Also at 07:28, 07:45 (31)" tools:visibility="visible"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/transit_now_validate"
              style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content"
              android:layout_height="wrap_content" android:layout_marginStart="52dp" android:layout_marginTop="4dp"
              android:minHeight="40dp" android:insetTop="0dp" android:insetBottom="0dp" android:maxLines="1"
              android:ellipsize="end" android:paddingTop="0dp" android:paddingBottom="0dp"
              android:visibility="gone"/>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:id="@+id/transit_next" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:minHeight="40dp" android:orientation="horizontal"
          android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
          android:paddingTop="6dp">
          <TextView android:minWidth="56dp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="10dp" android:text="@string/riga_trip_then"
            android:textAppearance="?attr/textAppearanceLabelLarge" android:textColor="?android:textColorSecondary"/>
          <TextView android:id="@+id/transit_next_badge" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minWidth="28dp" android:gravity="center"
            android:fontFeatureSettings="tnum" android:textSize="13sp" android:textStyle="bold"
            android:importantForAccessibility="no" tools:text="49"/>
          <TextView android:id="@+id/transit_next_text" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:maxLines="2" android:ellipsize="end"
            android:fontFeatureSettings="tnum" android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?android:textColorPrimary" tools:text="Get off at Pavasara gatve · 07:39, 3 stops"/>
        </LinearLayout>
        <!-- Where to get off the coming ride, when neither the step now nor the one after it says so. -->
        <LinearLayout android:id="@+id/transit_off" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:minHeight="32dp" android:orientation="horizontal"
          android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
          android:visibility="gone">
          <TextView android:minWidth="56dp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="10dp" android:text="@string/riga_trip_off_label"
            android:textAppearance="?attr/textAppearanceLabelLarge" android:textColor="?android:textColorSecondary"/>
          <TextView android:id="@+id/transit_off_text" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:maxLines="2" android:ellipsize="end"
            android:fontFeatureSettings="tnum" android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?android:textColorPrimary" tools:text="Mazā Kalna iela · 17:17, in 14 min"/>
        </LinearLayout>
      </LinearLayout>
      <HorizontalScrollView android:id="@+id/transit_alternatives" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingTop="8dp" android:scrollbars="none"
        android:clipToPadding="false" android:visibility="gone">
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content"
          android:layout_height="wrap_content"/>
      </HorizontalScrollView>
    </LinearLayout>
    <!-- The open sheet: every step of the journey, scrolled to the current one during a trip. -->
    <androidx.core.widget.NestedScrollView android:id="@+id/transit_itinerary" android:layout_width="match_parent"
      android:layout_height="0dp" android:visibility="gone" android:fadingEdgeLength="16dp"
      android:requiresFadingEdge="vertical" android:scrollbars="vertical">
      <LinearLayout android:id="@+id/transit_itinerary_content" android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp"/>
    </androidx.core.widget.NestedScrollView>
    <!-- The panel's foot, in both sheet states: the plan's status lines, the ticket shortcut and an action on the
         start side; Start / End trip at the bottom end, beside them rather than on a row of its own. -->
    <LinearLayout android:id="@+id/transit_foot" android:orientation="horizontal" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:gravity="bottom">
      <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1">
        <!-- Folded during a trip: the step to do now and where to get off, beside End trip. -->
        <TextView android:id="@+id/transit_trip_off" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:paddingTop="4dp" android:paddingBottom="4dp"
          android:fontFeatureSettings="tnum" android:lineSpacingExtra="4dp"
          android:textAppearance="?attr/textAppearanceBodyMedium"
          android:textColor="?android:textColorPrimary" android:visibility="gone"/>
        <TextView android:id="@+id/transit_description" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:paddingTop="4dp" android:fontFeatureSettings="tnum"
          android:lineSpacingExtra="2dp" android:textAppearance="?attr/textAppearanceBodyMedium"
          android:textColor="?android:textColorPrimary"/>
        <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.TonalButton"
          android:id="@+id/transit_mobilly" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginTop="4dp" android:visibility="gone"/>
        <Button style="@style/Widget.Material3.Button.TextButton" android:id="@+id/transit_action"
          android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
      </LinearLayout>
      <com.google.android.material.button.MaterialButton android:id="@+id/transit_start"
        style="@style/MwmWidget.M3.Button.Primary" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="@dimen/margin_half"
        android:text="@string/riga_trip_start" app:icon="@drawable/ic_navigation" android:visibility="gone"/>
    </LinearLayout>
  </LinearLayout>
</app.organicmaps.routing.TransitPanelLayout>
